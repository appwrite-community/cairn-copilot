# Scripts (pnpm provision, pnpm seed). Never expose the API key to the browser.
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<PROJECT_ID>
APPWRITE_API_KEY=<API_KEY>
# Password for the four demo users that pnpm seed creates (at least 8 characters).
DEMO_PASSWORD=

# Web app (only VITE_ values reach the browser)
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=<PROJECT_ID>
# Optional: set to DEMO_PASSWORD to sign in with one click on a local machine. Never set it on a public deployment.
VITE_DEMO_PASSWORD=
